# Copy to .env (cp .env.example .env) and edit. .env is git-ignored.
APP_NAME=Series Tracker
ENVIRONMENT=local
# Use a local SQLite DB for quick start (default). For PostgreSQL, set DATABASE_URL as below.
# DATABASE_URL=sqlite:///./tracker.db
# PostgreSQL example:
DATABASE_URL=postgresql://postgres:8828@localhost:5432/backednd_tracker
# Optional password for PostgreSQL (if needed)
POSTGRES_PASSWORD=change-me-locally
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Server‑side only. Never expose this in the frontend.
LLM_API_KEY=<YOUR_LLM_API_KEY>
