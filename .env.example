# Copy to .env (cp .env.example .env) and edit. .env is git-ignored.
ENVIRONMENT=local
# Default: a local SQLite file. Nothing to install.
DATABASE_URL=sqlite:///./tracker.db
# Week 2 (PostgreSQL via Docker): pip install "psycopg[binary]" then use
# DATABASE_URL=postgresql+psycopg://tracker:change-me-locally@127.0.0.1:5432/tracker
POSTGRES_PASSWORD=change-me-locally
# Server-side only. Never put this in frontend code. Needed from Week 9 (Tech Radar).
LLM_API_KEY=
